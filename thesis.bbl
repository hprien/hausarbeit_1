    \verb 10.13052/jwe1540-9589.2178
    \endverb
    \field{issn}{1544-5976}
    \field{number}{7}
    \field{pages}{2187\bibrangedash 2208}
    \field{title}{Vulnerability Assessment for Applications Security Through
  Penetration Simulation and Testing}
